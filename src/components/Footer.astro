---
import { catalogo } from '../data';

const { negocio } = catalogo;
const anio = new Date().getFullYear();
---

<footer class="border-borde mt-16 border-t">
  <div class="contenedor text-gris flex flex-col gap-6 py-10 text-sm sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-col gap-1">
      <span class="font-display text-texto text-lg">{negocio.nombre}</span>
      <span>
        {negocio.direccion}, {negocio.ciudad}
      </span>
      <span>{negocio.formaDePago}</span>
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li>
        <a class="hover:text-texto" href="/cancelar">Cancelar una reserva</a>
      </li>
      <li>
        <a
          class="hover:text-texto"
          href={negocio.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Cómo llegar
        </a>
      </li>
      {negocio.instagram && (
        <li>
          <a
            class="hover:text-texto"
            href={negocio.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        </li>
      )}
      {negocio.tiktok && (
        <li>
          <a
            class="hover:text-texto"
            href={negocio.tiktok}
            target="_blank"
            rel="noopener noreferrer"
          >
            TikTok
          </a>
        </li>
      )}
    </ul>
  </div>
  <p class="contenedor text-gris/70 pb-8 text-xs">
    © {anio} {negocio.nombre}
  </p>
</footer>
