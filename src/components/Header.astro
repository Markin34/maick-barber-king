---
import { catalogo } from '../data';
import { RUTA_PANEL } from '../lib/panel';

interface Props {
  /** Modo panel: solo el nombre, sin los enlaces de la página pública. */
  app?: boolean;
}

const { app = false } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const enlaces = [
  { href: '/#barberos', texto: 'Barberos', soloEscritorio: true },
  { href: '/#servicios', texto: 'Servicios', soloEscritorio: true },
  { href: '/tienda', texto: 'Tienda', soloEscritorio: false },
];
---

<!-- Sin enlace al panel a propósito: el dueño entra escribiendo la dirección secreta (src/lib/panel.ts). -->
<header class="border-borde/60 bg-fondo/90 sticky top-0 z-30 border-b backdrop-blur">
  <nav class="contenedor flex h-16 items-center justify-between gap-3" aria-label="Principal">
    <!-- whitespace-nowrap + tamaño según el ancho: el nombre nunca se parte en dos líneas. -->
    <a
      href={app ? RUTA_PANEL : '/'}
      class="font-display text-laton min-w-0 truncate text-[clamp(1rem,4.6vw,1.5rem)] leading-none whitespace-nowrap"
    >
      {catalogo.negocio.nombre}
    </a>
    {app ? (
      <span class="text-gris shrink-0 text-sm font-semibold">Panel</span>
    ) : (
      <ul class="flex shrink-0 items-center gap-1 sm:gap-2">
        {enlaces.map((e) => (
          <li class={e.soloEscritorio ? 'hidden sm:block' : ''}>
            <a
              href={e.href}
              class="text-gris hover:text-texto rounded-lg px-2 py-2 text-sm font-semibold sm:px-3"
              aria-current={ruta === e.href ? 'page' : undefined}
            >
              {e.texto}
            </a>
          </li>
        ))}
        <li>
          <a
            href="/reservar"
            class="btn-principal min-h-10 px-4 text-sm"
            aria-current={ruta === '/reservar' ? 'page' : undefined}
          >
            Reservar
          </a>
        </li>
      </ul>
    )}
  </nav>
</header>
