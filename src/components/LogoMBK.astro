---
/**
 * Logo de Maick Barber King redibujado en vector (SVG): se ve nítido en cualquier pantalla.
 * Basado en el logo original (corona, aro dorado, MBK, tijeras y "SHAVE & HAIR CUTS").
 * Va sobre fondo negro: los recuadros negros cortan el aro detrás de la corona y del lema.
 */
interface Props {
  class?: string;
}
const { class: clase } = Astro.props;
---

<svg
  viewBox="0 0 1000 720"
  class={clase}
  role="img"
  aria-labelledby="mbk-titulo"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="mbk-titulo">Maick Barber King · MBK Shave & Hair Cuts</title>
  <defs>
    <!-- Oro con brillo: claro arriba, profundo en el medio, reflejo abajo. -->
    <linearGradient id="mbk-oro" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff4c2"></stop>
      <stop offset="0.28" stop-color="#f3c94a"></stop>
      <stop offset="0.55" stop-color="#b98516"></stop>
      <stop offset="0.78" stop-color="#f1d277"></stop>
      <stop offset="1" stop-color="#8c6414"></stop>
    </linearGradient>
    <linearGradient id="mbk-oro-h" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#c9971c" stop-opacity="0"></stop>
      <stop offset="0.2" stop-color="#d9a92a"></stop>
      <stop offset="0.5" stop-color="#ffe9a3"></stop>
      <stop offset="0.8" stop-color="#d9a92a"></stop>
      <stop offset="1" stop-color="#c9971c" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="mbk-aro" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f6d77a"></stop>
      <stop offset="0.45" stop-color="#a87412"></stop>
      <stop offset="1" stop-color="#f0c75a"></stop>
    </linearGradient>
    <linearGradient id="mbk-plata" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.5" stop-color="#a9adb3"></stop>
      <stop offset="1" stop-color="#eef0f2"></stop>
    </linearGradient>
    <radialGradient id="mbk-destello" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff3c4" stop-opacity="0.95"></stop>
      <stop offset="0.35" stop-color="#f2c14e" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="#f2c14e" stop-opacity="0"></stop>
    </radialGradient>
    <filter id="mbk-brillo" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="desenfoque"></feGaussianBlur>
      <feColorMatrix
        in="desenfoque"
        values="1 0 0 0 0.35  0 0.8 0 0 0.22  0 0 0.3 0 0  0 0 0 0.55 0"
      ></feColorMatrix>
      <feMerge>
        <feMergeNode></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>

  <!-- Aro -->
  <circle cx="500" cy="400" r="285" fill="none" stroke="url(#mbk-aro)" stroke-width="6"></circle>

  <!-- Corona (el recuadro negro corta el aro detrás de ella) -->
  <rect x="364" y="0" width="272" height="172" fill="#000"></rect>
  <g filter="url(#mbk-brillo)" transform="translate(500 174) scale(1.14) translate(-500 -174)">
    <path
      d="M410 152 L396 92 L446 126 L452 70 L488 118 L500 42 L512 118 L548 70 L554 126 L604 92 L590 152 Z"
      fill="url(#mbk-oro)"
    ></path>
    <circle cx="396" cy="84" r="9" fill="url(#mbk-oro)"></circle>
    <circle cx="452" cy="62" r="9" fill="url(#mbk-oro)"></circle>
    <circle cx="500" cy="33" r="10" fill="url(#mbk-oro)"></circle>
    <circle cx="548" cy="62" r="9" fill="url(#mbk-oro)"></circle>
    <circle cx="604" cy="84" r="9" fill="url(#mbk-oro)"></circle>
    <rect x="404" y="150" width="192" height="24" rx="5" fill="url(#mbk-oro)"></rect>
    <line
      x1="410"
      y1="162"
      x2="590"
      y2="162"
      stroke="#8c6414"
      stroke-width="2"
      opacity="0.6"
    ></line>
  </g>

  <!-- Línea con destello bajo la corona -->
  <rect x="190" y="212" width="620" height="5" fill="url(#mbk-oro-h)"></rect>
  <ellipse cx="500" cy="214" rx="120" ry="16" fill="url(#mbk-destello)"></ellipse>

  <!-- MBK -->
  <text
    x="500"
    y="478"
    text-anchor="middle"
    textLength="560"
    lengthAdjust="spacing"
    font-size="290"
    fill="url(#mbk-oro)"
    filter="url(#mbk-brillo)"
    style="font-family: var(--font-display)"
  >
    MBK
  </text>
  <rect x="300" y="492" width="300" height="3" fill="url(#mbk-oro-h)"></rect>

  <!-- Líneas que bajan hacia las tijeras -->
  <line x1="296" y1="508" x2="438" y2="588" stroke="url(#mbk-aro)" stroke-width="4"></line>
  <line x1="704" y1="508" x2="562" y2="588" stroke="url(#mbk-aro)" stroke-width="4"></line>

  <!-- Tijeras cruzadas -->
  <g stroke="url(#mbk-plata)" stroke-linecap="round" fill="none">
    <path d="M462 588 L544 504" stroke-width="7"></path>
    <path d="M538 588 L456 504" stroke-width="7"></path>
    <circle cx="452" cy="598" r="13" stroke-width="5"></circle>
    <circle cx="548" cy="598" r="13" stroke-width="5"></circle>
  </g>
  <circle cx="500" cy="546" r="4" fill="#fff"></circle>

  <!-- Lema (el recuadro negro corta el aro detrás del texto) -->
  <rect x="245" y="616" width="510" height="52" fill="#000"></rect>
  <rect x="120" y="640" width="125" height="3" fill="url(#mbk-oro-h)"></rect>
  <rect x="755" y="640" width="125" height="3" fill="url(#mbk-oro-h)"></rect>
  <text
    x="500"
    y="657"
    text-anchor="middle"
    textLength="480"
    lengthAdjust="spacing"
    font-size="42"
    fill="#ececec"
    style="font-family: var(--font-sans); font-weight: 400; letter-spacing: 0.14em"
  >
    SHAVE &amp; HAIR CUTS
  </text>
</svg>
