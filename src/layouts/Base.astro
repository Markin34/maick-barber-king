---
import '@fontsource/rozha-one/400.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { catalogo } from '../data';
import { DIAS } from '../data/schema';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Páginas privadas (como el panel) no aparecen en Google. */
  noIndex?: boolean;
  /** Modo app (panel): sin el menú de la página pública ni el pie. */
  app?: boolean;
}

const { negocio } = catalogo;
const { titulo, descripcion = negocio.descripcion, noIndex = false, app = false } = Astro.props;
const tituloCompleto = titulo
  ? `${titulo} · ${negocio.nombre}`
  : `${negocio.nombre} · ${negocio.eslogan}`;
const canonica = new URL(Astro.url.pathname, Astro.site);

const codigoDia: Record<(typeof DIAS)[number], string> = {
  domingo: 'Sunday',
  lunes: 'Monday',
  martes: 'Tuesday',
  miercoles: 'Wednesday',
  jueves: 'Thursday',
  viernes: 'Friday',
  sabado: 'Saturday',
};
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'BarberShop',
  name: negocio.nombre,
  description: negocio.descripcion,
  url: Astro.site?.toString(),
  telephone: negocio.whatsapp,
  priceRange: 'Bs',
  paymentAccepted: 'Cash, QR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: negocio.direccion,
    addressLocality: negocio.ciudad,
    addressCountry: 'BO',
  },
  sameAs: [negocio.instagram, negocio.tiktok].filter(Boolean),
  openingHoursSpecification: DIAS.flatMap((dia) => {
    const h = negocio.horario[dia];
    if (!h) return [];
    // Con almuerzo, Google muestra dos tramos (mañana y tarde).
    const tramos = h.descanso
      ? [
          [h.abre, h.descanso.desde],
          [h.descanso.hasta, h.cierra],
        ]
      : [[h.abre, h.cierra]];
    return tramos.map(([opens, closes]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: codigoDia[dia],
      opens,
      closes,
    }));
  }),
};
---

<!doctype html>
<html lang="es-BO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="bg-laton text-fondo sr-only z-50 rounded-lg px-4 py-2 font-bold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Saltar al contenido
    </a>
    <div class="poste" aria-hidden="true"></div>
    <Header app={app} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    {!app && <Footer />}
    <script>
      // Solo en la página publicada: en desarrollo los errores se ven en la consola.
      import { configSupabase } from '../lib/config';
      import { escucharErrores } from '../lib/reportar-errores';

      const config = import.meta.env.PROD ? configSupabase() : undefined;
      if (config) escucharErrores(config);
    </script>
  </body>
</html>
