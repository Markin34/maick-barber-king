# Copia este archivo como .env y completa los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). En Vercel ponlos en Settings → Environment Variables.
# Si se dejan vacíos, la página funciona igual pero sin bloquear horas ocupadas (solo WhatsApp).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dirección secreta del panel, sin la barra (mínimo 12 caracteres: minúsculas, números y guiones).
# Obligatoria en Vercel. En tu computadora, si la dejas vacía, el panel queda en /panel-local-pruebas.
PANEL_RUTA=
